# kiro-gateway configuration (copy to .env or export in your shell)
# Agent-mode requests (scripts, curl) name their project with X-Kiro-Workspace; these
# patterns say which directories they may pick. WORKSPACE is only the fallback.
KIRO_GATEWAY_ALLOWED_WORKSPACES=/Users/me/code/*
KIRO_GATEWAY_WORKSPACE=/Users/me/code/scratch
KIRO_GATEWAY_API_KEY=replace-with-a-long-random-value
KIRO_GATEWAY_HOST=127.0.0.1
KIRO_GATEWAY_PORT=8000
KIRO_GATEWAY_ENGINE=v3
# Agent mode only (scripts/curl): allow-always for your own machine; deny refuses every
# tool request Kiro makes (reads still work) and is the base for PERMISSION_RULES.
KIRO_GATEWAY_PERMISSIONS=allow-always
#KIRO_GATEWAY_PERMISSION_RULES=allow:kind=read,search,fetch
#KIRO_GATEWAY_DEFAULT_MODEL=claude-sonnet-4.6
#KIRO_GATEWAY_EFFORT=medium
#KIRO_GATEWAY_HARNESS_WORKSPACE=                     # empty = scratch dir (recommended)
#KIRO_GATEWAY_RATE_LIMIT_RPM=0
#KIRO_GATEWAY_TIMEOUT=900
#KIRO_GATEWAY_MODEL_ALIASES=gpt-4*=gpt-5.6-terra
KIRO_GATEWAY_SESSION_MODE=affinity
KIRO_GATEWAY_MAX_CONCURRENCY=4
#KIRO_GATEWAY_TOOL_MODE=mcp            # mcp (default) | emulate | ignore | reject
KIRO_GATEWAY_TOOL_ACTIVITY=thought
